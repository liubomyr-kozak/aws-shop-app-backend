{
  "name": "cloudx-shop-be",
  "version": "1.0.0",
  "description": "backend for cloudx course",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "bundle:products": "esbuild src/products/getProductsListHandler.ts src/products/getProductByIdHandler.ts src/products/createProductHandler.ts src/importProducts/importProductsFileHandler.ts src/importProducts/importFileParserHandler.ts  --bundle --platform=node --tree-shaking --target=node20  --minify --keep-names --outdir=dist",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "seed:products": "ts-node scripts/seed-products.ts",
    "seed:stocks": "ts-node scripts/seed-stocks.ts",
    "test": "jest",
    "generate:swagger": "ts-node swagger/generate-swagger.ts",
    "serve:swagger": "serve swagger -p 3002",
    "start-api": "ts-node local-api.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/aws-lambda": "^8.10.152",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.5.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "aws-sdk-client-mock": "^4.1.0",
    "esbuild": "^0.25.10",
    "jest": "^30.1.3",
    "swagger-ui-dist": "^5.29.0",
    "ts-jest": "^29.4.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.896.0",
    "@aws-sdk/client-s3": "^3.901.0",
    "@aws-sdk/s3-request-presigner": "^3.901.0",
    "@types/uuid": "^10.0.0",
    "aws-lambda": "^1.0.7",
    "csv-parser": "^3.2.0",
    "swagger-jsdoc": "^6.2.8",
    "uuid": "^8.3.2"
  }
}
